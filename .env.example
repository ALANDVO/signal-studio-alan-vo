# Server and Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./signal_studio.db
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Authentication / OIDC Configuration
AUTH_DEMO_MODE=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/signal-studio
OIDC_CLIENT_ID=signal-studio-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=signal-studio-app

# LLM Gateway Configuration
# LLM_API_KEY is the single credential variable for upstream model calls.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
